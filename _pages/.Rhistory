library(gapminder)
library(tidyverse)
gapminder %>%
select(pop,year,gdpPercap) %>%
filter(pop > mean(pop) & year == 2007) %>%
mutate(total_gdp_b = pop*gdpPercap/10^9) %>%
arrange(total_gdp) -> output_data
library(gapminder)
library(tidyverse)
gapminder %>%
select(pop,year,gdpPercap) %>%
filter(pop > mean(pop) & year == 2007) %>%
mutate(total_gdp_b = pop*gdpPercap/10^9) %>%
arrange(total_gdp_b) -> output_data
