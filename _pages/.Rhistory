library(gapminder)
library(tidyverse)
library(gapminder)
library(tidyverse)
gapminder %>%
select(pop,year) %>%
filter(pop > mean(pop)) %>%
arrange(pop) -> output_data
output_data
library(gapminder)
library(tidyverse)
gapminder %>%
select(pop,year,gdpPercap) %>%
filter(pop > mean(pop) & year == 2007) %>%
mutate(total_gdp = pop*gdpPercap)
arrange(total_gdp) -> output_data
