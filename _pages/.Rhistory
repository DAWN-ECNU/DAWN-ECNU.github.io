library(gapminder)
library(tidyverse)
gapminder %>%
select(country,pop,year,gdpPercap) %>%
filter(pop > mean(pop) & year == 2007) %>%
mutate(total_gdp_b = pop*gdpPercap/10^9) %>%
arrange(total_gdp_b) -> output_data
output_data
library(gapminder)
library(tidyverse)
gapminder %>%
select(country,pop,year,gdpPercap) %>%
filter(pop > mean(pop) & year == 2007) %>%
mutate(total_gdp_b = pop*gdpPercap/10^9) %>%
arrange(desc(total_gdp_b)) -> output_data
output_data
# 使用 base R 的 summary
summary(mtcars$mpg)
# 使用 dplyr 精确提取五数 (常用 fivenum 函数)
mtcars %>%
summarise(
min = min(mpg),
q1 = quantile(mpg, 0.25),
median = median(mpg),
q3 = quantile(mpg, 0.75),
max = max(mpg),
mean = mean(mpg) # 把你想要的平均数也加上
)
gapminder %>%
select(country,pop,year,gdpPercap) %>%
filter(pop > mean(pop) & year == 2007) %>%
mutate(total_gdp_b = pop*gdpPercap/10^9) %>%
arrange(desc(total_gdp_b)) -> output_data
output_data
