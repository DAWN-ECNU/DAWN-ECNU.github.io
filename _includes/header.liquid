<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if dawn_section %}
        <a class="navbar-brand dawn-navbar-brand" href="{{ '/' | relative_url }}" aria-label="DAWN 破晓研究组，返回主页">
          <img src="{{ '/assets/img/logo.webp' | relative_url }}" alt="">
          <span class="dawn-brand-word"><span>DAWN</span><span aria-hidden="true">·</span><span class="dawn-brand-cn">破晓</span></span>
        </a>
      {% else %}
        <a class="navbar-brand title font-weight-lighter" href="{{ '/' | relative_url }}">{{ site.title }}</a>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          <!-- About and the other sections -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link or dawn_section == 'teaching' and p.permalink == '/teaching/' %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if dawn_section %}
            <li class="dawn-stats-nav">
              <button
                id="dawn-stats-toggle"
                type="button"
                aria-label="查看网站访问统计"
                aria-expanded="false"
                aria-controls="dawn-site-stats-panel"
                title="访问统计"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4 19V5M4 19h16M9 16v-4m5 4V8m5 8V5"/>
                </svg>
                <span class="dawn-stats-label">访问统计</span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="切换显示主题" aria-label="切换显示主题">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if dawn_section %}
    <aside id="dawn-site-stats-panel" class="dawn-site-stats" aria-label="网站访问统计" hidden>
      <div class="dawn-site-stats__heading">
        <strong>访问统计</strong><button class="dawn-site-stats__close" type="button" aria-label="关闭访问统计">×</button>
      </div>
      <div class="dawn-site-stats__grid">
        <div class="dawn-site-stats__item"><span>今日访客</span><strong title="需接入每日访客统计">—</strong></div>
        <div class="dawn-site-stats__item"><span>月活访客</span><strong title="需接入近30日访客统计">—</strong></div>
        <div class="dawn-site-stats__item"><span>累计访问</span><strong id="dawn-total-visits" aria-live="polite">—</strong></div>
      </div>
      <span class="dawn-site-stats__note">今日与月活待接入</span>
      <span id="busuanzi_container_site_pv" class="dawn-stat-source"><span id="busuanzi_value_site_pv"></span></span>
    </aside>
  {% endif %}
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
