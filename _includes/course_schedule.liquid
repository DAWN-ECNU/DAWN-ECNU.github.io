{% assign course = site.teachings | where: 'course_id', include.course_id | first %}

{% if course %}
  <div class="course">
    {% if course.schedule %}
      <div class="table-responsive">
        <table class="table align-middle" style="min-width: 860px;" data-material-counts data-course-id="{{ course.course_id | escape }}">
          <thead>
            <tr>
              <th scope="col" class="text-center" style="width: 80px;">Week</th>
              <th scope="col" class="text-center" style="width: 100px;">Module</th>
              <th scope="col">Topic</th>
              <th scope="col" class="text-nowrap">在线查看</th>
              <th scope="col" class="text-nowrap">离线下载</th>
              <th scope="col" class="text-center text-nowrap">累计点击</th>
            </tr>
          </thead>
          <tbody>
            {% for entry in course.schedule %}
              <tr data-week="{{ entry.week | escape }}">
                <td class="text-center">{{ entry.week }}</td>

                <td class="text-center">
                  {% if entry.type %}
                    {% if entry.type == '软件安装' %}
                      <span class="badge rounded-pill" style="background-color: #6c757d; font-weight: 500; padding: 0.5em 0.8em;">
                        {{- entry.type -}}
                      </span>
                    {% elsif entry.type == '基础章节' %}
                      <span class="badge rounded-pill" style="background-color: #0d6efd; font-weight: 500; padding: 0.5em 0.8em;">
                        {{- entry.type -}}
                      </span>
                    {% elsif entry.type == '专题章节' %}
                      <span class="badge rounded-pill" style="background-color: #198754; font-weight: 500; padding: 0.5em 0.8em;">
                        {{- entry.type -}}
                      </span>
                    {% else %}
                      <span class="badge rounded-pill bg-dark" style="font-weight: 500; padding: 0.5em 0.8em;">{{ entry.type }}</span>
                    {% endif %}
                  {% endif %}
                </td>
                <td>
                  {% if entry.topic %}
                    <div class="fw-bold" style="font-size: 1.05rem;">{{ entry.topic }}</div>
                  {% endif %}
                  {% if entry.description %}
                    <div class="schedule-description text-muted small mt-1">
                      {{ entry.description | markdownify | remove: '<p>' | remove: '</p>' }}
                    </div>
                  {% endif %}
                </td>
                <td>
                  {% if entry.materials %}
                    <ul class="schedule-materials list-unstyled mb-0">
                      {% for material in entry.materials %}
                        {% assign material_kind = material.kind | default: 'resource' %}
                        {% case material_kind %}
                          {% when 'tutorial' %}
                            {% assign material_kind_label = '教程' %}
                          {% when 'slides' %}
                            {% assign material_kind_label = '课件' %}
                          {% else %}
                            {% assign material_kind_label = '资料' %}
                        {% endcase %}
                        <li class="mb-2">
                          {% if material.url %}
                            <a
                              class="schedule-material-link"
                              href="{{ material.url | relative_url | escape }}"
                              target="_blank"
                              rel="noopener"
                              {% if material_kind == 'tutorial' or material_kind == 'slides' %}
                                data-material-click
                                data-course-id="{{ course.course_id | escape }}"
                                data-week="{{ entry.week | escape }}"
                                data-material-kind="{{ material_kind | escape }}"
                                data-action="view"
                              {% endif %}
                              aria-label="在线查看：{{ entry.topic | escape }} · {{ material_kind_label }} · {{ material.name | escape }}"
                            >
                              <i class="fas fa-external-link-alt schedule-material-action" aria-hidden="true"></i>
                              <span class="schedule-material-kind schedule-material-kind--{{ material_kind | escape }}">
                                <span
                                  class="schedule-material-kind-icon"
                                  data-material-morphicon="{{ material_kind | escape }}"
                                  aria-hidden="true"
                                >
                                  {% include course_material_icon.liquid kind=material_kind %}
                                </span>
                                <span>{{ material_kind_label }}</span>
                              </span>
                              <span class="schedule-material-name">{{ material.name }}</span>
                            </a>
                          {% else %}
                            <span class="text-secondary">{{ material.name }}</span>
                          {% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </td>
                <td>
                  {% if entry.materials %}
                    <ul class="schedule-materials list-unstyled mb-0">
                      {% for material in entry.materials %}
                        {% assign material_kind = material.kind | default: 'resource' %}
                        {% case material_kind %}
                          {% when 'tutorial' %}
                            {% assign material_kind_label = '教程' %}
                          {% when 'slides' %}
                            {% assign material_kind_label = '课件' %}
                          {% else %}
                            {% assign material_kind_label = '资料' %}
                        {% endcase %}
                        <li class="mb-2">
                          {% if material.url %}
                            <a
                              class="schedule-material-link"
                              href="{{ material.url | relative_url | escape }}"
                              download="{{ material.url | split: '/' | last | escape }}"
                              {% if material_kind == 'tutorial' or material_kind == 'slides' %}
                                data-material-click
                                data-course-id="{{ course.course_id | escape }}"
                                data-week="{{ entry.week | escape }}"
                                data-material-kind="{{ material_kind | escape }}"
                                data-action="download"
                              {% endif %}
                              aria-label="离线下载：{{ entry.topic | escape }} · {{ material_kind_label }} · {{ material.name | escape }}"
                            >
                              <i class="fas fa-download schedule-material-action" aria-hidden="true"></i>
                              <span class="schedule-material-kind schedule-material-kind--{{ material_kind | escape }}">
                                <span
                                  class="schedule-material-kind-icon"
                                  data-material-morphicon="{{ material_kind | escape }}"
                                  aria-hidden="true"
                                >
                                  {% include course_material_icon.liquid kind=material_kind %}
                                </span>
                                <span>{{ material_kind_label }}</span>
                              </span>
                              <span class="schedule-material-name">{{ material.name }}</span>
                            </a>
                          {% else %}
                            <span class="text-secondary">{{ material.name }}</span>
                          {% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </td>
                <td class="text-center">
                  {% if entry.materials and entry.materials.size > 0 %}
                    <output class="schedule-material-count" data-material-count-week="{{ entry.week | escape }}" aria-live="polite">—</output>
                  {% else %}
                    <span aria-label="暂无资料">—</span>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>
{% endif %}

{% if course.schedule %}
  <script src="{{ '/assets/js/course-material-morphicons.min.js' | relative_url }}" defer></script>
{% endif %}
